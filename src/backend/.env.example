# Application configuration
APP_NAME=Intelligent IaC Validation Backend
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:80

# Database Configuration (Local MongoDB or AWS DocumentDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=iac_validation_db
DOCUMENTDB_TLS=false
DOCUMENTDB_TLS_CA_FILE=
DOCUMENTDB_INSECURE_TLS=false

# AWS Storage Configuration (S3)
USE_S3_STORAGE=false
S3_BUCKET_NAME=
AWS_REGION=us-east-1

# AI / ML Assurance Engine
AI_ENGINE_URL=http://localhost:9000
AI_ENGINE_MOCK=false
AI_ENGINE_TIMEOUT=60

# AWS Bedrock & CloudWatch (used by ML engine)
USE_AWS_BEDROCK=false
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
USE_AWS_CLOUDWATCH=false
