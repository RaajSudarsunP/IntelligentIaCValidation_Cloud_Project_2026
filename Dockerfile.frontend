# ==============================================================================
# Dockerfile for Intelligent IaC Assurance - React Frontend
# Multi-stage build: Vite compile -> Nginx lightweight runtime
# ==============================================================================

# Stage 1: Build React application with Node.js
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY Frontend/package.json Frontend/package-lock.json* ./
RUN npm ci || npm install

# Copy source and build static distribution
COPY Frontend/ ./
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

# Stage 2: Serve static files with high-performance Nginx
FROM nginx:1.27-alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html
COPY Frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
